    "onboarding.slide1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every morning Mom taps one button in Telegram to say she is fine. Nothing to install on her side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое утро мама одной кнопкой в Telegram сообщает, что всё хорошо. Ей не нужно ничего устанавливать."
          }
        }
      }
    },
    "onboarding.slide1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One button for Mom"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка у мамы"
          }
        }
      }
    },
    "onboarding.slide2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calling every day rarely works out — work, time zones. Worrying every day works out by itself. One morning tap from Mom, and you call out of joy, not out of worry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонить каждый день не выходит — работа, часовые пояса. Тревожиться каждый день выходит само. Одна мамина кнопка утром — и вы звоните от радости, а не от тревоги."
          }
        }
      }
    },
    "onboarding.slide2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a replacement for calls"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не вместо звонков"
          }
        }
      }
    },
    "onboarding.slide3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No geolocation. Mom is a participant, not a subject of surveillance: you only see what she tapped herself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакой геолокации. Мама — участник, а не объект наблюдения: вы видите только то, что она сама нажала."
          }
        }
      }
    },
    "onboarding.slide3.title": {
